{
    "name": "ten-minutes",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "check": "turbo run check",
        "dev:web": "turbo run dev --filter=@ten-minutes/web",
        "dev:api": "turbo run dev --filter=@ten-minutes/api",
        "db:up": "docker compose up -d db",
        "db:down": "docker compose down",
        "db:logs": "docker compose logs -f db",
        "test": "turbo run test",
        "tet:web": "turbo run test --filter=@ten-minutes/web"
    },
    "packageManager": "bun@1.3.14",
    "devDependencies": {
        "turbo": "^2.10.10"
    }
}
